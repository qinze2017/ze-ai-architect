[
{{- $pages := where site.RegularPages "Section" "in" (slice "projects" "learning" "progress" "posts") -}}
{{- range $i, $p := $pages -}}
  {{- if $i }},{{ end }}
  {
    "title": {{ $p.Title | jsonify }},
    "url": {{ $p.RelPermalink | jsonify }},
    "section": {{ $p.Section | jsonify }},
    "summary": {{ ($p.Summary | plainify | htmlUnescape) | jsonify }},
    "content": {{ ($p.Plain | htmlUnescape) | jsonify }},
    "tags": {{ ($p.Params.tags | default slice) | jsonify }},
    "date": {{ $p.Date.Format "2006-01-02" | jsonify }}
  }
{{- end -}}
]
